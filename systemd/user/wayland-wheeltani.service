[Unit]
Description=Progressive middle-button autoscroll daemon for Wayland
Documentation=https://github.com/docloulou/Wayland-Wheeltani
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple
ExecStart=/home/l0n3/.cargo/bin/wayland-wheeltani --no-interactive --config /home/l0n3/.config/wayland-wheeltani/config.toml
Restart=on-failure
RestartSec=2
PrivateTmp=true
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/l0n3/.config/wayland-wheeltani

[Install]
WantedBy=default.target
